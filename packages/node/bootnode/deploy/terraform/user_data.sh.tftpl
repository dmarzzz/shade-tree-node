#!/usr/bin/env bash
# cloud-init user_data for a fresh Ubuntu 24.04 droplet. Rendered by OpenTofu/
# Terraform (bootnode/deploy/terraform) and run ONCE, as root, at first boot.
#
# This is a THIN WRAPPER, not a reimplementation: it exports the same env
# tunables bootnode/deploy/bootstrap.sh reads, fetches bootstrap.sh at the pinned
# ref, and hands off. bootstrap.sh does all the real work (clone repo, install
# Node + Tor, mint onions, write + start the three systemd units).
set -euo pipefail

# --- tunables passed straight through to bootstrap.sh ---
export SHADE_TREE_REPO="${git_repo}"
export SHADE_TREE_REF="${git_ref}"
export SHADE_TREE_ADMISSION="${admission}"
export SHADE_TREE_BOOTNODE_PORT="${bootnode_port}"
export SHADE_TREE_GATEWAY_PORT="${gateway_port}"

# Invited admission is the default. Materialize the operator's public commitments in a
# root-only file; bootstrap.sh validates and copies it into the service's deploy-state.
install -m 0600 /dev/null /root/shade-tree-members.json
printf '%s' '${members_json_b64}' | base64 --decode > /root/shade-tree-members.json
export SHADE_TREE_MEMBERS_FILE=/root/shade-tree-members.json

LOG=/var/log/shade-tree-bootstrap.log
exec > >(tee -a "$LOG") 2>&1

echo "[shade-tree] $(date -u) first-boot provisioning: ref=${git_ref} admission=${admission}"

# On first boot cloud-init and unattended-upgrades can hold the apt lock; wait it
# out so bootstrap.sh's own apt-get calls don't race.
for i in $(seq 1 30); do
  if apt-get update -qq >/dev/null 2>&1; then
    break
  fi
  echo "[shade-tree] waiting for apt lock (attempt $i)..."
  sleep 5
done

# Fetch bootstrap.sh at the SAME pinned ref the box will clone, then delegate.
RAW_URL="https://raw.githubusercontent.com/${repo_slug}/${git_ref}/bootnode/deploy/bootstrap.sh"
echo "[shade-tree] fetching bootstrap.sh: $RAW_URL"
curl -fsSL --retry 5 --retry-delay 5 "$RAW_URL" -o /root/shade-tree-bootstrap.sh

echo "[shade-tree] handing off to bootstrap.sh"
bash /root/shade-tree-bootstrap.sh

echo "[shade-tree] $(date -u) provisioning complete."
echo "[shade-tree] onions + signer were printed above; also: journalctl -u shade-tree-bootnode -u shade-tree-gateway -u shade-tree-heartbeat"
